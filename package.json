{
    "name": "aquasense360",
    "version": "1.0.0",
    "description": "AquaSense360 - IoT Smart Fish Health Monitoring System",
    "main": "electron/main.js",
    "author": "AquaSense360",
    "license": "MIT",
    "scripts": {
        "start": "concurrently -n backend,frontend -c blue,green \"npm start --prefix backend\" \"npm start --prefix frontend\"",
        "backend": "npm start --prefix backend",
        "frontend": "npm start --prefix frontend",
        "build:frontend": "cd frontend && npm run build",
        "electron:dev": "npx electron .",
        "predist": "cd frontend && npm run build",
        "dist": "npx electron-builder --win",
        "dist:portable": "npx electron-builder --win portable"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "electron": "^33.3.1",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.aquasense360.app",
        "productName": "AquaSense360",
        "copyright": "Copyright © 2026 AquaSense360",
        "directories": {
            "output": "dist"
        },
        "files": [
            "package.json",
            "electron/main.js",
            "electron/preload.js",
            "backend/**/*",
            "frontend/build/**/*",
            "!backend/node_modules/.cache"
        ],
        "extraResources": [
            {
                "from": "ml-service/dist/aquasense-ml",
                "to": "extraResources/ml",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "asarUnpack": [
            "backend/**/*",
            "frontend/build/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "installerHeaderIcon": "build/icon.ico",
            "uninstallerIcon": "build/icon.ico",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "AquaSense360",
            "installerSidebar": null,
            "license": null
        }
    }
}